<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="GsController" Language="2052" Version="$(var.Version)" Manufacturer="Local Development" UpgradeCode="3B7F2C64-9A1D-4E58-8C2B-6D5A0F7E4B19">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="Main" Title="GsController" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
    </Feature>
    <!--
      Full-uninstall cleanup (docs/msi-uninstall-cleanup.md).
      Both custom actions are declared INSIDE the Product element so they
      are always linked into the final database; a Fragment copy would
      need an explicit reference to survive linking.

      GsPrepareUninstall: graceful stop + scheduled-task removal via the
      deployed CLI (-File reference only, never an ad-hoc -Command
      expression). GsRemoveSupervisorTask: fixed-name schtasks fallback
      that runs even when the CLI could not do the removal (broken
      runtime, custom StateDir). Cleanup failure must never block the
      MSI uninstall (Return="ignore"); the MSI log records the action.

      Conditions: run on a plain uninstall only. REMOVE="ALL" keeps
      install / repair / feature-modify out; NOT UPGRADINGPRODUCTCODE
      keeps the old product's removal during a major upgrade out, so the
      upgraded product keeps reusing the same scheduled task.
    -->
    <CustomAction Id="GsPrepareUninstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]gs-product.ps1&quot; -Action PrepareUninstall"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="GsRemoveSupervisorTask"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[WindowsFolder]System32\schtasks.exe&quot; /Delete /TN &quot;GsControllerSupervisor&quot; /F"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="GsPrepareUninstall" Before="GsRemoveSupervisorTask">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="GsRemoveSupervisorTask" Before="RemoveFiles">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="ManufacturerFolder" Name="Local Development">
          <Directory Id="INSTALLFOLDER" Name="GsController" />
        </Directory>
      </Directory>
      <!-- Declared so the GsRemoveSupervisorTask working directory
           (Directory="SystemFolder" on the custom action) resolves at
           link time. This working-directory property can point to
           SysWOW64; the executable uses an explicit System32 path above. -->
      <Directory Id="SystemFolder" />
    </Directory>
  </Fragment>
</Wix>
